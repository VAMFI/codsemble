{
  "name": "codsemble",
  "version": "0.2.0",
  "description": "Repository-aware multi-agent team generation for Codex.",
  "private": true,
  "license": "Apache-2.0",
  "author": "VAMFI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VAMFI/codsemble.git"
  },
  "homepage": "https://github.com/VAMFI/codsemble#readme",
  "bugs": {
    "url": "https://github.com/VAMFI/codsemble/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "archive": "node scripts/plugin-archive.mjs",
    "archive:verify": "node scripts/plugin-archive.mjs --check",
    "check": "npm run typecheck && npm run test && npm run build && node scripts/validate-catalog.mjs",
    "checksums": "node scripts/checksums.mjs",
    "checksums:verify": "node scripts/checksums.mjs --check",
    "sbom": "node scripts/sbom.mjs",
    "sbom:verify": "node scripts/sbom.mjs --check",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ignore": "^7.0.5",
    "smol-toml": "^1.4.2",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
