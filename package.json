    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ignore": "^7.0.5",
    "smol-toml": "^1.4.2",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@types/node": "^24.0.15",
    "esbuild": "^0.25.8",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
